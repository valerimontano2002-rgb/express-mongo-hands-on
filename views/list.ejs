
<%- include("header") -%>

<div class="box" id="heading">

  <h1><%= listTitle %></h1>

  <!-- DESPLEGABLE DE LISTAS -->
  <div style="padding-bottom: 18px; text-align: center;">

    <label for="listNav"
      style="color: #ffffff;
             font-size: 13.5px;
             display: block;
             margin-bottom: 6px;
             font-weight: 500;">
      Listas tareas de VALERIA MONTAÑO
    </label>

    <select id="listNav"
      aria-label="Cambiar de lista de tareas"
      onchange="window.location.href =
        (this.value === 'Today'
          ? '/'
          : '/' + encodeURIComponent(this.value));"
      style="padding: 7px 12px;
             border-radius: 8px;
             border: 1px solid #ccc;
             font-size: 14px;
             background: #ffffff;
             color: #333;
             cursor: pointer;
             outline: none;
             max-width: 90%;">

      <option value="Today"
        <%= listTitle === 'Today' ? 'selected' : '' %>>
        Today
      </option>

      <% allLists.forEach(function(list) { %>
        <% if (list.name !== 'Today') { %>

          <option value="<%= list.name %>"
            <%= listTitle === list.name
                ? 'selected' : '' %>>
            <%= list.name %>
          </option>

        <% } %>
      <% }); %>

    </select>
  </div>
</div>

<!-- LISTA DE TAREAS -->
<div class="box">

  <% newListItems.forEach(function(item) { %>

    <form action="/delete" method="post">

      <div class="item">
        <input type="checkbox"
          name="checkbox"
          value="<%= item._id %>"
          aria-label="Eliminar tarea"
          onchange="this.form.submit()">

        <p>
          <%= item.name %>

          <% if (
            typeof item.priority_name !== 'undefined'
            && item.priority_name
          ) { %>
            <span class="badge"
              style="background-color:
                <%= item.priority_color %>;">
              <%= item.priority_name %>
            </span>
          <% } %>
        </p>
      </div>

      <input type="hidden"
        name="listName"
        value="<%= listTitle %>">

    </form>

  <% }); %>

  <!-- FORMULARIO PARA AÑADIR TAREAS -->
  <form class="item" action="/" method="post">

    <input type="text"
      name="newItem"
      placeholder="Nueva tarea"
      autocomplete="off"
      required>

    <% if (
      typeof priorities !== 'undefined'
      && priorities.length > 0
    ) { %>

      <select name="priorityId"
        class="priority-select"
        title="Selecciona urgencia">

        <option value="">Sin urgencia</option>

        <% priorities.forEach(function(p) { %>
          <option value="<%= p.id %>">
            <%= p.name %>
          </option>
        <% }); %>

      </select>

    <% } %>

    <button type="submit"
      name="list"
      value="<%= listTitle %>">
      +
    </button>

  </form>

</div>

<%- include("footer") -%>
